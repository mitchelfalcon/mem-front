# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# Salesforce Apex REST — MEM_SlackApprovalService
# GET {SF_INSTANCE_URL}/services/apexrest/mem/v1/authorize/?tx=&action=APPROVE|REJECT
SF_INSTANCE_URL=""
SF_ACCESS_TOKEN=""
SF_AUTHORIZE_PATH="/services/apexrest/mem/v1/authorize/"

# Slack — Bot MEM Agent posts HITL alert + canvas to this DM
# https://app.slack.com/client/T06E6HP8A2W/D0BNHUA8R7D
SLACK_BOT_TOKEN=""
SLACK_CHANNEL="D0BNHUA8R7D"
SLACK_TEAM_ID="T06E6HP8A2W"
# Optional: reuse an existing Slack canvas instead of creating one
SLACK_CANVAS_ID=""

# Heroku MCP for Salesforce Agentforce Registry
# API Name must be memhealthcare (Salesforce rejects hyphens in API names)
# Do NOT commit Client Secret / HEROKU_API_KEY — set them with heroku config:set
HEROKU_APP_NAME="memhealthcare-app"
HEROKU_MCP_SERVER_URL="https://memhealthcare-app-01f3bfd4e4a3.herokuapp.com/"
HEROKU_IDENTITY_URL="https://id.heroku.com"
HEROKU_OAUTH_SCOPE="global"
HEROKU_OAUTH_CLIENT_ID=""
HEROKU_OAUTH_CLIENT_SECRET=""
HEROKU_API_KEY=""
